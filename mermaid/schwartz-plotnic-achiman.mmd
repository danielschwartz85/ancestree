flowchart TB
  
      %% סבים מצד דניאל
      LIVIO["ליביו שוורץ"] --- MALI["מלי פלוטניק"]
      LIVIO --- ILANA["אילנה"]
  
      MALI --> MOSHE["משה שוורץ"]
      MALI --> MEIR["מאיר שוורץ"]
  
      ILANA --> DANIEL["דניאל שוורץ"]
      ILANA --> RAVIT["רווית"]
  
      %% המשפחה של דניאל ויערה
      DANIEL --- YAARA["יערה אחימן"]
      DANIEL --> LAVI["לביא שוורץ"]
      DANIEL --> BEERI["בארי שוורץ"]
  
      %% רווית
      RAVIT --- URI_R["אורי"]
      RAVIT --> ROMI["רומי"]
  
      RAVIT --- EMANUEL["עמנואל"]
      RAVIT --> OLIVER["אוליבר"]
  
      %% ההורים של יערה
      RAMI["רמי אחירם"] --- YAEL["יעל בר לוי"]
      RAMI --> YAARA
      RAMI --> AYALA["איילה"]
      RAMI --> RENANA["רננה"]
  
      %% רננה
      RENANA --- SHMULIK["שמוליק אלון"]
      RENANA --> TAMAR["תמר"]
      RENANA --> HILLEL["הלל"]
  
      %% איילה
      AYALA --- OMER["עומר"]
      AYALA --> GIL["גיל"]
      AYALA --> SHIRA["שירה"]
      AYALA --> URI_A["אורי"]
  
      %% צבעים
      classDef male fill:#cfe8ff,stroke:#4a90e2,color:#111;
      classDef female fill:#ffd6e7,stroke:#d66b9c,color:#111;
      classDef focus fill:#fff2b2,stroke:#c9a900,stroke-width:3px,color:#111;
  
      class LIVIO,MOSHE,MEIR,DANIEL,URI_R,EMANUEL,OLIVER,RAMI,SHMULIK,OMER,GIL,URI_A male;
      class MALI,ILANA,RAVIT,YAARA,YAEL,AYALA,RENANA,TAMAR,HILLEL,SHIRA female;
      class LAVI,BEERI focus;